# Google Gemini API (Required)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Neo4j Knowledge Graph (Required)
# Free tier: https://neo4j.com/cloud/aura-free/
NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# MongoDB Knowledge Base (Required)
# Free tier: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=policy_compliance_kb

# LangSmith Tracing (HIGHLY RECOMMENDED for research)
# Free tier: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=autonomous-policy-monitor
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
